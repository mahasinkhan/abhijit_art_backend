// backend/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  client
  admin
  employee
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
}

enum MediaType {
  image
  video
}

enum StockUnit {
  piece
  sqft
  metre
  roll
  sheet
  litre
  kg
  box
  set
}

enum MovementType {
  opening
  purchase
  consumption
  wastage
  returned
  adjustment
}

enum CustomerSource {
  online
  offline
}

enum DiscountType {
  amount
  percent
}

enum InvoiceStatus {
  unpaid
  partial
  paid
  cancelled
}

enum PaymentMethod {
  cash
  online
}

enum TaskStatus {
  pending
  in_progress
  completed
  cancelled
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  phone          String          @default("")
  password       String
  role           Role            @default(client)
  bookings       Booking[]
  stockMovements StockMovement[]
  invoices       Invoice[]
  payments       Payment[]
  auditLogs      AuditLog[]
  tasksAssigned  Task[]          @relation("TasksAssigned")
  tasksCreated   Task[]          @relation("TasksCreated")
  tasksDelivered Task[]          @relation("TasksDelivered")
  quickOrders    QuickOrder[]    @relation("QuickOrderCreated")
  quickOrderPayments QuickOrderPayment[] @relation("QuickOrderPaymentCreated")
  purchasesCreated SupplierPurchase[] @relation("PurchaseCreated")
  supplierPayments SupplierPayment[]  @relation("SupplierPaymentCreated")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  address String?
  notes   String?
  source  CustomerSource @default(online)
}

model Service {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  priceFrom   Int       @default(0)
  icon        String    @default("🛠️")
  active      Boolean   @default(true)
  bookings    Booking[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Booking {
  id             String          @id @default(cuid())
  user           User            @relation(fields: [userId], references: [id])
  userId         String
  service        Service?        @relation(fields: [serviceId], references: [id])
  serviceId      String?
  serviceName    String
  quantity       Int             @default(1)
  notes          String          @default("")
  contactPhone   String          @default("")
  deliveryMethod String          @default("pickup")
  address        String          @default("")
  preferredDate  DateTime?
  designLink     String          @default("")
  totalAmount    Int?
  unitRate       Decimal?        @db.Decimal(12, 2)
  subtotal       Int?
  discountType   String?
  discountValue  Decimal?        @db.Decimal(12, 2)
  discountAmount Int?
  taxPercent     Decimal?        @db.Decimal(5, 2)
  taxAmount      Int?
  rating         Int?
  status         BookingStatus   @default(pending)
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Post {
  id        String    @id @default(cuid())
  caption   String    @default("")
  mediaUrl  String
  mediaType MediaType
  publicId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Lead {
  id        String   @id @default(cuid())
  name      String   @default("")
  phone     String   @default("")
  email     String   @default("")
  message   String   @default("")
  page      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id        String          @id @default(cuid())
  name      String
  phone     String          @default("")
  email     String          @default("")
  gstin     String          @default("")
  address   String          @default("")
  notes     String          @default("")
  active    Boolean         @default(true)
  items     InventoryItem[]
  movements StockMovement[]
  totalPurchased Decimal   @default(0) @db.Decimal(14, 2)
  totalPaid      Decimal   @default(0) @db.Decimal(14, 2)
  lastPurchaseAt DateTime?
  purchases  SupplierPurchase[]
  payments   SupplierPayment[]
  itemPrices ItemSupplier[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  @@index([name])
}

model InventoryItem {
  id          String    @id @default(cuid())
  sku         String    @unique
  name        String
  description String    @default("")
  category    String    @default("")
  unit        StockUnit @default(piece)
  quantity     Decimal @default(0) @db.Decimal(14, 3)
  reorderLevel Decimal @default(0) @db.Decimal(14, 3)
  costPrice Decimal  @default(0) @db.Decimal(12, 2)
  sellPrice Decimal? @db.Decimal(12, 2)
  location String  @default("")
  imageUrl String  @default("")
  active   Boolean @default(true)
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  movements      StockMovement[]
  purchaseLines  SupplierPurchaseItem[]
  supplierPrices ItemSupplier[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([name])
  @@index([category])
  @@index([active])
}

model ItemSupplier {
  id         String        @id @default(cuid())
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId     String
  supplier   Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId String
  price       Decimal @db.Decimal(12, 2)
  supplierSku String  @default("")
  preferred   Boolean @default(false)
  note        String  @default("")
  lastRate       Decimal?  @db.Decimal(12, 2)
  lastPurchaseAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([itemId, supplierId])
  @@index([itemId])
  @@index([supplierId])
}

model StockMovement {
  id     String        @id @default(cuid())
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId String
  type MovementType
  quantity Decimal @db.Decimal(14, 3)
  delta    Decimal @db.Decimal(14, 3)
  balance  Decimal @db.Decimal(14, 3)
  unitCost Decimal? @db.Decimal(12, 2)
  reference String @default("")
  note      String @default("")
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchase   SupplierPurchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  purchaseId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  bookingId String?
  invoice   Invoice? @relation("InvoiceStock", fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?
  createdAt DateTime @default(now())
  @@index([itemId, createdAt])
  @@index([type])
  @@index([bookingId])
  @@index([purchaseId])
  @@index([invoiceId])
}

model SupplierPurchase {
  id         String   @id @default(cuid())
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId String
  billNo   String   @default("")
  billDate DateTime
  discType DiscountType @default(amount)
  discVal  Decimal      @default(0) @db.Decimal(12, 2)
  taxPct   Decimal      @default(0) @db.Decimal(5, 2)
  subtotal    Decimal @db.Decimal(14, 2)
  discountAmt Decimal @default(0) @db.Decimal(14, 2)
  taxAmt      Decimal @default(0) @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2)
  notes String @default("")
  items     SupplierPurchaseItem[]
  movements StockMovement[]
  createdBy   User?   @relation("PurchaseCreated", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([supplierId, billDate])
  @@index([billDate])
  @@index([billNo])
}

model SupplierPurchaseItem {
  id         String           @id @default(cuid())
  purchase   SupplierPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  purchaseId String
  item   InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemId String?
  name   String
  unit   StockUnit @default(piece)
  quantity Decimal @db.Decimal(14, 3)
  rate     Decimal @db.Decimal(12, 2)
  amount   Decimal @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  @@index([purchaseId])
  @@index([itemId])
}

model SupplierPayment {
  id         String        @id @default(cuid())
  supplier   Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId String
  amount     Decimal       @db.Decimal(14, 2)
  method     PaymentMethod @default(cash)
  note       String        @default("")
  paidAt     DateTime      @default(now())
  createdBy   User?   @relation("SupplierPaymentCreated", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt DateTime @default(now())
  @@index([supplierId, paidAt])
}

model Invoice {
  id          String   @id @default(cuid())
  invoiceNo   String   @unique
  date        DateTime
  clientName  String
  clientPhone String?
  clientEmail String?
  clientGstin String?
  clientAddr  String?
  source      CustomerSource @default(offline)
  business    Json
  items       Json
  discType    DiscountType @default(amount)
  discVal     Decimal      @default(0) @db.Decimal(12, 2)
  taxPct      Decimal      @default(0) @db.Decimal(5, 2)
  subtotal    Decimal  @db.Decimal(12, 2)
  discountAmt Decimal  @db.Decimal(12, 2)
  taxAmt      Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  paidAmount  Decimal  @default(0) @db.Decimal(12, 2)
  payments    Payment[]
  notes       String?
  warranty    String?
  lessAmount  Decimal  @default(0) @db.Decimal(12, 2)
  stockApplied   Boolean         @default(false)
  stockMovements StockMovement[] @relation("InvoiceStock")
  lastRemindedAt DateTime?
  reminderCount  Int      @default(0)
  status      InvoiceStatus @default(unpaid)
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([createdAt])
  @@index([clientName])
  @@index([status])
}

model Payment {
  id        String        @id @default(cuid())
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod @default(cash)
  note      String        @default("")
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt DateTime @default(now())
  @@index([invoiceId, createdAt])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  images      String[]
  links       String[]
  priority    TaskPriority @default(medium)
  status      TaskStatus   @default(pending)
  deadline    DateTime?
  notes       String?
  startedAt   DateTime?
  completedAt DateTime?
  deliveredAt   DateTime?
  deliveredBy   User?    @relation("TasksDelivered", fields: [deliveredById], references: [id], onDelete: SetNull)
  deliveredById String?
  customerName  String?
  customerPhone String?
  customerEmail String?
  orderDate     DateTime?
  amount        Int       @default(0)
  advancePaid   Int       @default(0)
  invoiceId     String?
  invoiceNo     String?
  quickOrder   QuickOrder? @relation("QuickOrderTask", fields: [quickOrderId], references: [id], onDelete: SetNull)
  quickOrderId String?     @unique
  assignedTo   User   @relation("TasksAssigned", fields: [assignedToId], references: [id])
  assignedToId String
  createdBy    User   @relation("TasksCreated", fields: [createdById], references: [id])
  createdById  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([assignedToId, status])
  @@index([status])
  @@index([createdAt])
  @@index([deliveredById])
  @@index([quickOrderId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String   @default("invoice")
  entityId  String?
  entityRef String   @default("")
  summary   String
  detail    Json?
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName String   @default("")
  ip        String   @default("")
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([entity, entityId])
  @@index([action])
}

enum QuickOrderStatus {
  unbilled
  billed
}

model QuickOrder {
  id            String        @id @default(cuid())

  // customer snapshot
  customerId    String?
  customerName  String
  customerPhone String        @default("")
  customerEmail String        @default("")
  whatsapp      String?

  // what the job is
  title         String?
  workDetails   String        @default("")
  items         Json          @default("[]")
  description   String        @default("")

  // reference images uploaded by admin
  images        String[]      @default([])

  // money
  amount        Decimal       @db.Decimal(12, 2)
  lessAmount    Decimal       @default(0) @db.Decimal(12, 2)
  advancePaid   Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(cash)

  // billing lifecycle
  status        QuickOrderStatus @default(unbilled)
  invoiceId     String?
  invoiceNo     String?

  // work assignment (1:1 Task via quickOrderId @unique)
  task          Task?         @relation("QuickOrderTask")
  payments      QuickOrderPayment[] @relation("QuickOrderPayments")

  // who created it
  createdBy     User?         @relation("QuickOrderCreated", fields: [createdById], references: [id], onDelete: SetNull)
  createdById   String?

  entryDate     DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([entryDate])
  @@index([customerName])
  @@index([status])
  @@index([customerId])
}

model QuickOrderPayment {
  id        String        @id @default(cuid())
  order     QuickOrder    @relation("QuickOrderPayments", fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod @default(cash)
  note      String        @default("")
  createdBy User?         @relation("QuickOrderPaymentCreated", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt DateTime      @default(now())

  @@index([orderId, createdAt])
}
