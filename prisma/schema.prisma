// backend/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  client
  admin
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
}

enum MediaType {
  image
  video
}

enum StockUnit {
  piece
  sqft
  metre
  roll
  sheet
  litre
  kg
  box
  set
}

enum MovementType {
  opening      // starting balance when the item is created
  purchase     // stock in from a supplier
  consumption  // used on a job / booking
  wastage      // misprint, damage, offcut loss
  returned     // unused stock back on the shelf, or sent back to supplier
  adjustment   // physical stock-count correction (can go either way)
}

enum CustomerSource {
  online
  offline
}

enum DiscountType {
  amount
  percent
}

enum InvoiceStatus {
  unpaid
  partial
  paid
  cancelled
}

// how a single payment was made — cash vs online (UPI / card / bank transfer)
enum PaymentMethod {
  cash
  online
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  phone          String          @default("")
  password       String
  role           Role            @default(client)
  bookings       Booking[]
  stockMovements StockMovement[]
  invoices       Invoice[]
  payments       Payment[]
  auditLogs      AuditLog[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  address String?
  notes   String?
  source  CustomerSource @default(online)
}

model Service {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  priceFrom   Int       @default(0)
  icon        String    @default("🛠️")
  active      Boolean   @default(true)
  bookings    Booking[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Booking {
  id             String          @id @default(cuid())
  user           User            @relation(fields: [userId], references: [id])
  userId         String
  service        Service?        @relation(fields: [serviceId], references: [id])
  serviceId      String?
  serviceName    String
  quantity       Int             @default(1)
  notes          String          @default("")
  contactPhone   String          @default("")
  deliveryMethod String          @default("pickup")
  address        String          @default("")
  preferredDate  DateTime?
  designLink     String          @default("")
  totalAmount    Int?            // admin-set order total (₹) — required before confirmed/completed
  // price breakdown behind totalAmount, so the client invoice can show real
  // Discount/GST lines. All money is Int (whole ₹) to match totalAmount, and
  // total = subtotal − discountAmount + taxAmount exactly.
  unitRate       Decimal?        @db.Decimal(12, 2)  // rate/unit — the one field that may carry paise
  subtotal       Int?
  discountType   String?                             // "amount" | "percent"
  discountValue  Decimal?        @db.Decimal(12, 2)  // what was typed (₹150.50 or 7.5%)
  discountAmount Int?
  taxPercent     Decimal?        @db.Decimal(5, 2)
  taxAmount      Int?
  rating         Int?            // client's 1–5 star rating (BookingDetails already reads this)
  status         BookingStatus   @default(pending)
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Post {
  id        String    @id @default(cuid())
  caption   String    @default("")
  mediaUrl  String
  mediaType MediaType
  publicId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Lead {
  id        String   @id @default(cuid())
  name      String   @default("")
  phone     String   @default("")
  email     String   @default("")
  message   String   @default("")
  page      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ───────────────────────────── INVENTORY ─────────────────────────────

model Supplier {
  id        String          @id @default(cuid())
  name      String
  phone     String          @default("")
  email     String          @default("")
  gstin     String          @default("")
  address   String          @default("")
  notes     String          @default("")
  active    Boolean         @default(true)
  items     InventoryItem[]
  movements StockMovement[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([name])
}

model InventoryItem {
  id          String    @id @default(cuid())
  // code on the rack label, e.g. FLX-3X50-WHT
  sku         String    @unique
  name        String
  description String    @default("")
  // free text so a new category needs no migration
  category    String    @default("")
  unit        StockUnit @default(piece)

  // Running balance. Never write this directly — always go through a
  // StockMovement inside a transaction so the ledger and the balance
  // can never drift apart.
  // Decimal, not Int: flex is billed in sqft (34.5), ink in litres (2.75).
  quantity     Decimal @default(0) @db.Decimal(14, 3)
  // quantity <= reorderLevel flags the item as LOW on the dashboard
  reorderLevel Decimal @default(0) @db.Decimal(14, 3)

  // Per-unit rates. Decimal because printing rates are routinely ₹12.50/sqft.
  costPrice Decimal  @default(0) @db.Decimal(12, 2)
  sellPrice Decimal? @db.Decimal(12, 2)

  // where it physically sits: "Rack B / Shelf 2"
  location String  @default("")
  imageUrl String  @default("")
  active   Boolean @default(true)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  movements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([category])
  @@index([active])
}

model StockMovement {
  id     String        @id @default(cuid())
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId String

  type MovementType

  // Always positive — what the user typed in.
  quantity Decimal @db.Decimal(14, 3)
  // Signed value actually applied to the balance. purchase/returned/opening
  // are positive, consumption/wastage negative, adjustment either way.
  // Pre-signing this makes every report a simple SUM.
  delta    Decimal @db.Decimal(14, 3)
  // Balance immediately AFTER this movement, frozen at write time, so
  // history reads without replaying the whole ledger.
  balance  Decimal @db.Decimal(14, 3)

  // per-unit cost on a purchase; null on every other type
  unitCost Decimal? @db.Decimal(12, 2)

  // supplier bill / challan number
  reference String @default("")
  note      String @default("")

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  // which job consumed this stock — enables per-order costing
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  bookingId String?

  // who recorded it — the audit trail
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  createdAt DateTime @default(now())

  @@index([itemId, createdAt])
  @@index([type])
  @@index([bookingId])
}

// ───────────────────────── BILLING / INVOICES ─────────────────────────

model Invoice {
  id          String   @id @default(cuid())
  invoiceNo   String   @unique
  date        DateTime

  // billed-to snapshot (frozen so a saved bill always shows who it was for)
  clientName  String
  clientPhone String?
  clientEmail String?
  clientGstin String?
  clientAddr  String?

  // registered (online) customer vs walk-in (offline) — shown as a badge,
  // switchable when editing the bill. Reuses the CustomerSource enum.
  source      CustomerSource @default(offline)

  // full snapshots so a saved bill re-renders exactly as it was issued
  business    Json     // { name, address, phone, email, gstin, pan }
  items       Json     // [{ desc, qty, rate }]

  // charges as entered
  discType    DiscountType @default(amount)
  discVal     Decimal      @default(0) @db.Decimal(12, 2)
  taxPct      Decimal      @default(0) @db.Decimal(5, 2)

  // totals frozen at save time (computed on the server)
  subtotal    Decimal  @db.Decimal(12, 2)
  discountAmt Decimal  @db.Decimal(12, 2)
  taxAmt      Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)

  // amount received so far = cached SUM of the payments below; balance due =
  // total − paidAmount. Recomputed server-side whenever a payment changes.
  paidAmount  Decimal  @default(0) @db.Decimal(12, 2)

  // itemised payment history — each cash/online payment (incl. the advance)
  // is one row here; this is the source of truth for how much is paid.
  payments    Payment[]

  notes       String?
  warranty    String?

  // payment-reminder tracking — when this client was last nudged about a
  // balance due + how many reminders have been sent (email or WhatsApp).
  lastRemindedAt DateTime?
  reminderCount  Int      @default(0)

  status      InvoiceStatus @default(unpaid)

  // who created it — audit trail; SetNull so deleting an admin never drops a bill
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
  @@index([clientName])
  @@index([status])
}

// One received payment against an invoice — the advance at billing time, or
// any later part payment. Append-only history: each row records how much was
// paid and by cash or online. Deleting a row (a correction) is PIN-gated and
// audited. The invoice's paidAmount is always the SUM of its payments.
model Payment {
  id        String        @id @default(cuid())
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod @default(cash)
  note      String        @default("") // optional ref, e.g. "UPI 4821" / "cash at counter"

  // who recorded it — survives if the user is later deleted
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  createdAt DateTime @default(now())

  @@index([invoiceId, createdAt])
}

// ───────────────────────── SECURITY / AUDIT ─────────────────────────

// Generic key/value config store. Holds the hashed billing PIN under the
// key "billing_pin_hash" (bcrypt). Reusable for future settings.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Tamper trail: one row per sensitive action, so any change to the records
// is attributable to who + when + what. Never edited or deleted from the app.
model AuditLog {
  id        String   @id @default(cuid())
  action    String   // "invoice.create" | "invoice.payment" | "invoice.status" | "invoice.cancel" | "invoice.delete" | "invoice.edit" | "invoice.remind"
  entity    String   @default("invoice")
  entityId  String?  // the affected record's id
  entityRef String   @default("") // human handle, e.g. the invoice number
  summary   String   // one-line human description of what happened
  detail    Json?    // structured before/after (amounts, status, …)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName String   @default("") // frozen name, survives if the user is later deleted
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([action])
}