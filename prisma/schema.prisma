generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// operation = the operations employee who designs and uploads the public
/// site content: hero banners, the offer strip, service cards. Site content
/// only, no billing, inventory or customer money.
enum Role {
  client
  admin
  employee
  operation
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
}

enum MediaType {
  image
  video
}

enum StockUnit {
  piece
  sqft
  Square_Inch @map("Square Inch")
  inch
  feet
  metre
  roll
  sheet
  litre
  kg
  box
  set
}

enum MovementType {
  opening
  purchase
  consumption
  wastage
  returned
  adjustment
}

enum CustomerSource {
  online
  offline
}

enum DiscountType {
  amount
  percent
}

enum InvoiceStatus {
  unpaid
  partial
  paid
  cancelled
}

enum PaymentMethod {
  cash
  online
}

enum TaskStatus {
  pending
  in_progress
  completed
  cancelled
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

/// Covers both directions — the UI shows only the ones that fit the kind.
enum TxnCategory {
  // money out
  salary
  advance
  lent
  rent
  utilities
  transport
  materials
  food
  maintenance
  marketing
  other
  // money in
  sale
  loan_back
  refund
  other_income
  outside
}

enum TxnKind {
  income
  expense
}

/// Whether a payee is one of our own staff or an outside person/shop.
enum PayeeKind {
  employee
  outsider
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  username       String?         @unique
  phone          String          @default("")
  password       String
  role           Role            @default(client)
  bookings       Booking[]
  stockMovements StockMovement[]
  invoices       Invoice[]
  payments       Payment[]
  auditLogs      AuditLog[]
  tasksAssigned  Task[]          @relation("TasksAssigned")
  tasksCreated   Task[]          @relation("TasksCreated")
  tasksDelivered Task[]          @relation("TasksDelivered")
  quickOrders    QuickOrder[]    @relation("QuickOrderCreated")
  quickOrderPayments QuickOrderPayment[] @relation("QuickOrderPaymentCreated")
  purchasesCreated SupplierPurchase[] @relation("PurchaseCreated")
  supplierPayments SupplierPayment[]  @relation("SupplierPaymentCreated")
  customerPayments CustomerPayment[]  @relation("CustomerPaymentCreated")
  payeeProfile     Payee?             @relation("PayeeUser")
  expensesCreated  Expense[]          @relation("ExpenseCreatedBy")
  heroSlides       HeroSlide[]        @relation("HeroSlideCreated")
  promoStrips      PromoStrip[]       @relation("PromoStripCreated")
  serviceCards     ServiceCard[]      @relation("ServiceCardCreated")
  businessBundles  BusinessBundle[]   @relation("BusinessBundleCreated")
  bulkItems        BulkItem[]         @relation("BulkItemCreated")
  printCategories  PrintCategory[]    @relation("PrintCategoryCreated")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  address String?
  notes   String?
  source  CustomerSource @default(online)
}

model Service {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  priceFrom   Int       @default(0)
  icon        String    @default("🛠️")
  active      Boolean   @default(true)
  bookings    Booking[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Booking {
  id             String          @id @default(cuid())
  user           User            @relation(fields: [userId], references: [id])
  userId         String
  service        Service?        @relation(fields: [serviceId], references: [id])
  serviceId      String?
  serviceName    String
  quantity       Int             @default(1)
  notes          String          @default("")
  contactPhone   String          @default("")
  deliveryMethod String          @default("pickup")
  address        String          @default("")
  preferredDate  DateTime?
  designLink     String          @default("")
  totalAmount    Int?
  unitRate       Decimal?        @db.Decimal(12, 2)
  subtotal       Int?
  discountType   String?
  discountValue  Decimal?        @db.Decimal(12, 2)
  discountAmount Int?
  taxPercent     Decimal?        @db.Decimal(5, 2)
  taxAmount      Int?
  rating         Int?
  status         BookingStatus   @default(pending)
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Post {
  id        String    @id @default(cuid())
  caption   String    @default("")
  mediaUrl  String
  mediaType MediaType
  publicId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Lead {
  id        String   @id @default(cuid())
  name      String   @default("")
  phone     String   @default("")
  email     String   @default("")
  message   String   @default("")
  page      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id        String          @id @default(cuid())
  name      String
  phone     String          @default("")
  email     String          @default("")
  gstin     String          @default("")
  address   String          @default("")
  notes     String          @default("")
  active    Boolean         @default(true)
  items     InventoryItem[]
  movements StockMovement[]
  totalPurchased Decimal   @default(0) @db.Decimal(14, 2)
  totalPaid      Decimal   @default(0) @db.Decimal(14, 2)
  lastPurchaseAt DateTime?
  purchases  SupplierPurchase[]
  payments   SupplierPayment[]
  itemPrices ItemSupplier[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  @@index([name])
}

model InventoryItem {
  id          String    @id @default(cuid())
  sku         String    @unique
  name        String
  description String    @default("")
  category    String    @default("")
  unit        StockUnit @default(piece)
  quantity     Decimal @default(0) @db.Decimal(14, 3)
  reorderLevel Decimal @default(0) @db.Decimal(14, 3)
  costPrice Decimal  @default(0) @db.Decimal(12, 2)
  sellPrice Decimal? @db.Decimal(12, 2)
  location String  @default("")
  imageUrl String  @default("")
  active   Boolean @default(true)
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  movements      StockMovement[]
  purchaseLines  SupplierPurchaseItem[]
  supplierPrices ItemSupplier[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([name])
  @@index([category])
  @@index([active])
}

model ItemSupplier {
  id         String        @id @default(cuid())
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId     String
  supplier   Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId String
  price       Decimal @db.Decimal(12, 2)
  supplierSku String  @default("")
  preferred   Boolean @default(false)
  note        String  @default("")
  lastRate       Decimal?  @db.Decimal(12, 2)
  lastPurchaseAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([itemId, supplierId])
  @@index([itemId])
  @@index([supplierId])
}

model StockMovement {
  id     String        @id @default(cuid())
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId String
  type MovementType
  quantity Decimal @db.Decimal(14, 3)
  delta    Decimal @db.Decimal(14, 3)
  balance  Decimal @db.Decimal(14, 3)
  unitCost Decimal? @db.Decimal(12, 2)
  reference String @default("")
  note      String @default("")
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchase   SupplierPurchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  purchaseId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  bookingId String?
  invoice   Invoice? @relation("InvoiceStock", fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?
  createdAt DateTime @default(now())
  @@index([itemId, createdAt])
  @@index([type])
  @@index([bookingId])
  @@index([purchaseId])
  @@index([invoiceId])
}

model SupplierPurchase {
  id         String   @id @default(cuid())
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId String
  billNo   String   @default("")
  billDate DateTime
  discType DiscountType @default(amount)
  discVal  Decimal      @default(0) @db.Decimal(12, 2)
  taxPct   Decimal      @default(0) @db.Decimal(5, 2)
  subtotal    Decimal @db.Decimal(14, 2)
  discountAmt Decimal @default(0) @db.Decimal(14, 2)
  taxAmt      Decimal @default(0) @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2)
  notes String @default("")
  items     SupplierPurchaseItem[]
  movements StockMovement[]
  createdBy   User?   @relation("PurchaseCreated", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([supplierId, billDate])
  @@index([billDate])
  @@index([billNo])
}

model SupplierPurchaseItem {
  id         String           @id @default(cuid())
  purchase   SupplierPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  purchaseId String
  item   InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemId String?
  name   String
  unit   StockUnit @default(piece)
  quantity Decimal @db.Decimal(14, 3)
  rate     Decimal @db.Decimal(12, 2)
  amount   Decimal @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  @@index([purchaseId])
  @@index([itemId])
}

model SupplierPayment {
  id         String        @id @default(cuid())
  supplier   Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId String
  amount     Decimal       @db.Decimal(14, 2)
  method     PaymentMethod @default(cash)
  note       String        @default("")
  paidAt     DateTime      @default(now())
  createdBy   User?   @relation("SupplierPaymentCreated", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt DateTime @default(now())
  @@index([supplierId, paidAt])
}

model Customer {
  id        String         @id @default(cuid())
  name      String
  phone     String?        @unique
  email     String?
  gstin     String?
  address   String?
  source    CustomerSource @default(offline)
  invoices  Invoice[]
  payments  CustomerPayment[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([name])
  @@index([phone])
}

model Invoice {
  id          String   @id @default(cuid())
  invoiceNo   String   @unique
  date        DateTime
  clientName  String
  clientPhone String?
  clientEmail String?
  clientGstin String?
  clientAddr  String?
  /// short free-text note shown on the bill under Bill To — e.g. "School Banner Work"
  purpose     String?
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  source      CustomerSource @default(offline)
  business    Json
  items       Json
  discType    DiscountType @default(amount)
  discVal     Decimal      @default(0) @db.Decimal(12, 2)
  taxPct      Decimal      @default(0) @db.Decimal(5, 2)
  subtotal    Decimal  @db.Decimal(12, 2)
  discountAmt Decimal  @db.Decimal(12, 2)
  taxAmt      Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  paidAmount  Decimal  @default(0) @db.Decimal(12, 2)
  payments    Payment[]
  notes       String?
  warranty    String?
  lessAmount  Decimal  @default(0) @db.Decimal(12, 2)
  stockApplied   Boolean         @default(false)
  stockMovements StockMovement[] @relation("InvoiceStock")
  lastRemindedAt DateTime?
  reminderCount  Int      @default(0)
  status      InvoiceStatus @default(unpaid)
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([createdAt])
  @@index([clientName])
  @@index([status])
  @@index([customerId])
}

model Payment {
  id        String        @id @default(cuid())
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod @default(cash)
  note      String        @default("")
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt DateTime @default(now())
  @@index([invoiceId, createdAt])
}

/// Account-level payment from a customer — NOT tied to a single invoice.
/// The customer runs a tab: total billed minus total paid = balance due.
/// Allocation against individual invoices is computed at read time
/// (oldest invoice first), so adding, editing or deleting a payment
/// re-settles every invoice automatically — nothing to keep in sync.
model CustomerPayment {
  id         String        @id @default(cuid())
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod @default(cash)
  note       String        @default("")
  paidAt     DateTime      @default(now())
  createdBy   User?   @relation("CustomerPaymentCreated", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([customerId, paidAt])
  @@index([paidAt])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  images      String[]
  links       String[]
  priority    TaskPriority @default(medium)
  status      TaskStatus   @default(pending)
  deadline    DateTime?
  notes       String?
  startedAt   DateTime?
  completedAt DateTime?
  deliveredAt   DateTime?
  deliveredBy   User?    @relation("TasksDelivered", fields: [deliveredById], references: [id], onDelete: SetNull)
  deliveredById String?
  customerName  String?
  customerPhone String?
  customerEmail String?
  orderDate     DateTime?
  amount        Int       @default(0)
  advancePaid   Int       @default(0)
  invoiceId     String?
  invoiceNo     String?
  quickOrder   QuickOrder? @relation("QuickOrderTask", fields: [quickOrderId], references: [id], onDelete: SetNull)
  quickOrderId String?     @unique
  assignedTo   User   @relation("TasksAssigned", fields: [assignedToId], references: [id])
  assignedToId String
  createdBy    User   @relation("TasksCreated", fields: [createdById], references: [id])
  createdById  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([assignedToId, status])
  @@index([status])
  @@index([createdAt])
  @@index([deliveredById])
  @@index([quickOrderId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String   @default("invoice")
  entityId  String?
  entityRef String   @default("")
  summary   String
  detail    Json?
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName String   @default("")
  ip        String   @default("")
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([entity, entityId])
  @@index([action])
}

enum QuickOrderStatus {
  unbilled
  billed
}

model QuickOrder {
  id            String        @id @default(cuid())
  customerId    String?
  customerName  String
  customerPhone String        @default("")
  customerEmail String        @default("")
  whatsapp      String?
  title         String?
  workDetails   String        @default("")
  items         Json          @default("[]")
  description   String        @default("")
  images        String[]      @default([])
  amount        Decimal       @db.Decimal(12, 2)
  lessAmount    Decimal       @default(0) @db.Decimal(12, 2)
  advancePaid   Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(cash)
  status        QuickOrderStatus @default(unbilled)
  invoiceId     String?
  invoiceNo     String?
  quantity      String?
  expectedDelivery DateTime?
  task          Task?         @relation("QuickOrderTask")
  payments      QuickOrderPayment[] @relation("QuickOrderPayments")
  createdBy     User?         @relation("QuickOrderCreated", fields: [createdById], references: [id], onDelete: SetNull)
  createdById   String?
  entryDate     DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@index([entryDate])
  @@index([customerName])
  @@index([status])
  @@index([customerId])
}

model QuickOrderPayment {
  id        String        @id @default(cuid())
  order     QuickOrder    @relation("QuickOrderPayments", fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod @default(cash)
  note      String        @default("")
  createdBy User?         @relation("QuickOrderPaymentCreated", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt DateTime      @default(now())
  @@index([orderId, createdAt])
}

/// Anyone the shop pays money to — staff or outsider.
/// PHONE IS THE IDENTITY: one phone number = one person, so every payment
/// to that number groups under the same record no matter how the name was
/// typed. An employee's Payee row links back to their User account.
model Payee {
  id      String    @id @default(cuid())
  name    String
  nameKey String    @unique
  phone   String?   @unique
  kind   PayeeKind @default(outsider)

  /// set only for staff — links the payee to their login account
  user   User?   @relation("PayeeUser", fields: [userId], references: [id], onDelete: SetNull)
  userId String? @unique

  role   String  @default("")   // "Designer", "Driver", "Landlord"…
  notes  String  @default("")
  active Boolean @default(true)

  expenses Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([kind])
  @@index([active])
}

/// Day-to-day cash book — money in and money out, nothing to do with
/// Invoices or Quick Orders. Lending someone ₹5,000 is an expense with
/// category `lent`; getting it back is income with category `loan_back`,
/// and both point at the same Payee, so the running balance per person
/// is just a sum over their entries.
model Expense {
  id       String      @id @default(cuid())
  kind     TxnKind     @default(expense)
  date     DateTime    @default(now())
  category TxnCategory @default(other)
  title    String
  amount   Decimal     @db.Decimal(12, 2)
  method   PaymentMethod @default(cash)
  phone       String?


  /// optional — a shop sale has no person attached, a loan always does
  payee   Payee?  @relation(fields: [payeeId], references: [id], onDelete: Restrict)
  payeeId String?

  notes String @default("")

  createdBy   User?   @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([kind, date])
  @@index([category])
  @@index([payeeId, date])
  @@index([method])
}

/// Home page banner card. Uploaded and written by the operation role.
/// Two slides show side by side; further slides rotate as pairs.
model HeroSlide {
  id          String   @id @default(cuid())
  imageUrl    String
  publicId    String   @default("")
  alt         String   @default("")
  eyebrow     String   @default("")
  titleTop    String   @default("")
  titleBottom String   @default("")
  subtitle    String   @default("")
  /// button label and target, blank label hides the button
  ctaText     String   @default("")
  ctaHref     String   @default("/services")
  order       Int      @default(0)
  active      Boolean  @default(true)
  /// optional run window, both null means always on
  startsAt    DateTime?
  endsAt      DateTime?
  createdBy   User?    @relation("HeroSlideCreated", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, order])
  @@index([startsAt, endsAt])
}

/// The orange offer bar above the banner cards. Same owner as HeroSlide.
/// Only the highest ordered active row inside its run window is shown.
model PromoStrip {
  id        String   @id @default(cuid())
  text      String
  href      String   @default("/services")
  /// gradient ends, hex with the hash, blank falls back to the brand terracotta
  colorFrom String   @default("")
  colorTo   String   @default("")
  order     Int      @default(0)
  active    Boolean  @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdBy   User?  @relation("PromoStripCreated", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
  @@index([startsAt, endsAt])
}

/// One entry in the icon rail under the header, and the page behind it at
/// /category/<slug>. The icon itself is drawn in the frontend and matched
/// by slug, everything else here is editable by the operation role.
/// Print grid tiles and bulk rates join a category through their own
/// `category` field, which holds this slug.
model PrintCategory {
  id        String   @id @default(cuid())
  /// rail label, two short lines read best, e.g. "Flex & Banners"
  title     String
  slug      String   @unique
  /// which drawn icon to show in the rail, a key from the frontend icon
  /// registry such as banner, tshirt, mug. Blank picks one from the title.
  icon      String   @default("")
  /// an uploaded icon, used when none of the drawn ones fit. A square PNG
  /// with a transparent background. When set it wins over `icon`.
  iconUrl      String @default("")
  iconPublicId String @default("")
  /// one or two sentences at the top of the category page
  blurb     String   @default("")
  /// optional wide photo for the top of the page
  imageUrl  String   @default("")
  publicId  String   @default("")
  /// what the page sells, shown as a short list of bullet lines
  points    String   @default("")
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdBy   User?  @relation("PrintCategoryCreated", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
  @@index([slug])
}

/// A bulk rate card: "Bulk Visiting Cards, Rs 2 each for 500 pieces".
/// Shown as a grid on the home page and in full at /bulk-printing.
/// Uploaded by the operation role, photo on a plain light background.
model BulkItem {
  id         String   @id @default(cuid())
  name       String
  imageUrl   String
  publicId   String   @default("")
  /// rupees per piece at this quantity
  pricePer   Int      @default(0)
  /// the quantity that price applies to
  minQty     Int      @default(100)
  /// what one unit is called, e.g. pieces, sheets, sqft
  unit       String   @default("pieces")
  /// optional one-liner under the name, shown when pricePer is 0
  note       String   @default("")
  /// PrintCategory slug this belongs to, blank means it only shows in the
  /// full bulk list and not on any category page
  category   String   @default("")
  href       String   @default("/services")
  order      Int      @default(0)
  active     Boolean  @default(true)
  createdBy   User?   @relation("BulkItemCreated", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active, order])
}

/// "Shop by business needs" bundle: one tall card per industry, shown as a
/// carousel on the home page and as a full grid at /shop-by-business.
/// The operation role uploads a plain photo; the title, the line of items
/// and the Explore button are drawn over it by the frontend, so the text
/// stays editable and crisp instead of being baked into the image.
model BusinessBundle {
  id        String   @id @default(cuid())
  /// headline on the card, e.g. "Cafe & Restaurant"
  title     String
  /// the small line under it, e.g. "Menus, labels, tents"
  items     String   @default("")
  imageUrl  String
  publicId  String   @default("")
  /// url slug, used as /shop-by-business/<slug> when a detail page exists
  slug      String   @unique
  /// where the Explore button goes; blank falls back to the slug route
  href      String   @default("")
  ctaText   String   @default("Explore")
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdBy   User?  @relation("BusinessBundleCreated", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
  @@index([slug])
}

/// A product tile in the "what we print" grid under the hero. Photo, name,
/// a from-price and an optional badge. Uploaded by the operation role.
model ServiceCard {
  id        String   @id @default(cuid())
  name      String
  caption   String   @default("")
  imageUrl  String
  publicId  String   @default("")
  href      String   @default("/services")
  /// rupees, shown as "Starts from Rs X". 0 hides the price line.
  priceFrom Int      @default(0)
  /// short corner tag such as "Same day" or "Bestseller", blank hides it
  badge     String   @default("")
  /// PrintCategory slug this tile belongs to, blank means home grid only
  category  String   @default("")
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdBy   User?  @relation("ServiceCardCreated", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}
